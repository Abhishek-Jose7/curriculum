{
  "name": "crce-curr",
  "account_id": "3fee89dbc21324b8e8af78c20e12e85c",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "curriculum-db",
      "database_id": "f027de5d-d660-4b3e-a510-97a98cf0a033"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FILES_KV",
      "id": "3684b78105e64690a21eaf135039737d"
    }
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "queues": {
    "producers": [
      {
        "binding": "PUBLISH_QUEUE",
        "queue": "publish-queue"
      }
    ],
    "consumers": [
      {
        "queue": "publish-queue",
        "max_batch_size": 1
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "http://localhost:3000,https://curriculum-phi-lovat.vercel.app",
    "FRONTEND_URL": "https://curriculum-phi-lovat.vercel.app",
    "ENVIRONMENT": "production"
  },
  "env": {
    "production": {
      "vars": {
        "CORS_ALLOWED_ORIGINS": "https://curriculum-phi-lovat.vercel.app",
        "FRONTEND_URL": "https://curriculum-phi-lovat.vercel.app",
        "ENVIRONMENT": "production"
      }
    }
  }
}