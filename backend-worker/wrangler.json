{
  "name": "curriculum-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "curriculum-db",
      "database_id": "c4eb7d41-0a09-4b90-b4e7-1e4b2177428c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "curriculum-files"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "http://localhost:3000",
    "ENVIRONMENT": "development"
  },
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}