{
  "name": "curriculum-backend",
  "account_id": "23ab12dd6b6ee433ec780d13bb4995d8",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "curriculum-db",
      "database_id": "c4eb7d41-0a09-4b90-b4e7-1e4b2177428c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "curriculum-files"
    }
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "queues": {
    "producers": [
      {
        "binding": "PUBLISH_QUEUE",
        "queue": "publish-queue"
      }
    ],
    "consumers": [
      {
        "queue": "publish-queue",
        "max_batch_size": 1
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "http://localhost:3000,https://curriculum-phi-lovat.vercel.app",
    "FRONTEND_URL": "https://curriculum-phi-lovat.vercel.app",
    "ENVIRONMENT": "production"
  },
  "env": {
    "production": {
      "vars": {
        "CORS_ALLOWED_ORIGINS": "https://curriculum-phi-lovat.vercel.app",
        "FRONTEND_URL": "https://curriculum-phi-lovat.vercel.app",
        "ENVIRONMENT": "production"
      }
    }
  }
}