# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# URL of the deployed Cloudflare Worker backend
# Copy this file to frontend/.env and set the value below
NEXT_PUBLIC_API_URL=https://curriculum-backend.collacou.workers.dev/api

# ── Backend Worker (Cloudflare D1 / R2 / Workers) ───────────────────────────
# Set these as Wrangler secrets (wrangler secret put <NAME>):
#   AUTH_JWT_SECRET=<strong-random-secret>
#   BROWSERLESS_API_TOKEN=<token-from-browserless.io>
#
# Configured in backend-worker/wrangler.json (non-secret vars):
#   CORS_ALLOWED_ORIGINS, FRONTEND_URL, ENVIRONMENT
